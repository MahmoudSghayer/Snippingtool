# Production environment for @sl/api. Copy to infra/.env.production (next
# to infra/docker-compose.prod.yml, which reads it via `env_file`), fill in
# every value marked REQUIRED, and never commit the filled-in file (it's
# gitignored — see .gitignore's `.env.*` / `!infra/env/*.example` rule).
# Prefer generating/storing these through a secrets manager (Doppler/SOPS —
# docs/11-devops.md "secrets management") and rendering this file from it at
# deploy time over hand-editing a copy on the VM.
#
# Deployed by .github/workflows/release.yml on a `vX.Y.Z` tag push, gated by
# a GitHub Environment approval (docs/11-devops.md "Deployment guide").
# Validate before deploying:
#   node infra/scripts/check-env.mjs infra/.env.production

NODE_ENV=production
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# --- Data stores -------------------------------------------------------
# REQUIRED. If Postgres/Redis run as containers on the same VM (the default
# docker-compose.prod.yml shape), use the compose service names below with a
# strong generated password; if using a managed Postgres/Redis, use its
# connection string instead.
#
# Both URLs must be TLS in production — config/env.ts refuses to boot
# otherwise (docs/threat-model.md 3.7/3.8). For the in-VM shape that means
# running infra/scripts/gen-datastore-certs.sh first, which mints the CA and
# the two server certs these connections verify against; see
# docs/11-devops.md 5.2a.
DATABASE_URL=postgres://sl:CHANGE_ME@postgres:5432/sniper_ledger?sslmode=require
TEST_DATABASE_URL=
REDIS_URL=rediss://:CHANGE_ME@redis:6379
# PEM bundle used to verify the Redis server certificate. /certs/ca.crt is
# where docker-compose.prod.yml mounts the generated CA. Leave empty against
# a managed Redis whose certificate chains to a public root Node already
# trusts — verification stays on either way.
REDIS_TLS_CA_FILE=/certs/ca.crt
# Not exercised in production (no test suite runs here); schema default
# (15) is fine to leave as-is.
REDIS_TEST_DB=15

# --- Origins / CORS ------------------------------------------------------
# REQUIRED. The real production origins — CORS/cookie `Secure`/`SameSite`
# behaviour in apps/api depends on these being correct https:// URLs.
APP_ORIGIN=https://api.sniperledger.com
DASHBOARD_ORIGIN=https://sniperledger.com
# Comma-separated production Chrome Web Store extension ID(s) (both build
# targets — `ledger` and `ledger-auto` — get their own extension ID; list
# both once `ledger-auto` has a self-hosted update_url distribution).
EXTENSION_IDS=

# --- Cookies / CSRF --------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 32 — a value distinct from
# every other environment's.
COOKIE_SECRET=
# SameSite for sl_at/sl_rt/sl_csrf: lax (default) | strict | none. lax is the
# recommended same-site shape (dashboard and API on one registrable apex, or
# a same-site proxy/rewrite in front of both). Set none ONLY if the dashboard
# is served from a foreign apex (e.g. a bare *.vercel.app URL) — then also
# set COOKIE_SECURE=true and keep APP_ORIGIN/DASHBOARD_ORIGIN https://, or
# the API refuses to boot. See docs/11-devops.md §6.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# --- JWT (EdDSA / Ed25519) --------------------------------------------------
# REQUIRED. A dedicated production keypair, generated once
# (`pnpm --filter @sl/api keys:generate`) and stored only in the secrets
# manager / GitHub Environment secrets that render this file — rotating it
# invalidates every outstanding access token (see docs/04-auth.md).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Entitlement blob signing (Ed25519) -------------------------------------
# REQUIRED. A second dedicated keypair — rotating it invalidates every
# extension's cached offline-grace entitlement blob (forces a re-bootstrap
# on next heartbeat/online check).
ENTITLEMENT_SIGNING_KEY=
ENTITLEMENT_PUBLIC_KEY=

# --- Stripe (LIVE mode) -----------------------------------------------------
# REQUIRED for real billing. From https://dashboard.stripe.com/apikeys and
# your live Products/Prices; STRIPE_WEBHOOK_SECRET from the live webhook
# endpoint you register at https://api.sniperledger.com/api/v1/payments/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=
STRIPE_PRICE_LIFETIME=

# --- Email ---------------------------------------------------------------
# REQUIRED. Resend or a real SMTP relay — verification/reset/notification
# emails silently no-op without this in production, which blocks new
# signups (email verification is required before login by default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM="The Sniper's Ledger <noreply@sniperledger.com>"

# --- Rate limiting knobs ----------------------------------------------------
# Schema defaults — deliberately not loosened in production. Tune only with
# real traffic data in hand (see docs/11-devops.md's monitoring runbook).
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# --- Extension distribution --------------------------------------------
# Bump EXTENSION_LATEST_VERSION on every release so `ledger-auto`'s
# self-hosted update mechanism (and the dashboard's "update available"
# banner) pick it up; EXTENSION_UPDATE_URL is the self-hosted update
# manifest URL for ledger-auto (ledger itself updates via the Chrome Web
# Store's own update_url, not this one).
EXTENSION_LATEST_VERSION=0.1.0
EXTENSION_UPDATE_URL=https://api.sniperledger.com/extension/update-manifest.xml

# --- Misc --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Seed / bootstrap (not part of the zod schema; read directly by
# packages/db/src/seed.ts). Production's `migrator` service hard-codes
# RUN_SEED=false (docker-compose.prod.yml) — run the FIRST super-admin seed
# once, by hand, against a fresh database (docs/11-devops.md's deployment
# guide "first migration + seed admin" step), then leave these blank; seed
# is idempotent but there's no reason to keep a plaintext admin password in
# this file after the one-time bootstrap. ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- infra/docker-compose.prod.yml's own interpolation (${VAR} in that
# file, NOT read by @sl/api itself). ---
DOMAIN=sniperledger.com
ACME_EMAIL=devops@sniperledger.com
REGISTRY=ghcr.io/sniper-ledger
IMAGE_TAG=v0.1.0
API_REPLICAS=2
WORKER_REPLICAS=1
DASHBOARD_REPLICAS=1
POSTGRES_USER=sl
POSTGRES_DB=sniper_ledger
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Discord channel webhook that receives every Prometheus alert (Server
# Settings → Integrations → Webhooks → Copy URL). Leave it blank and the
# alerts only show up in Prometheus and Grafana, which nobody is watching.
ALERT_DISCORD_WEBHOOK_URL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Read-only Postgres role for Grafana's Business KPIs dashboard — grant
# SELECT on analytics_daily/mv_kpi_daily/v_mrr/v_arr only (docs/11-devops.md
# "secrets management"), never the app's own read/write `sl` credentials.
GRAFANA_PG_USER=sl_ro
GRAFANA_PG_PASSWORD=CHANGE_ME
# S3-compatible backup destination (strongly recommended in production —
# infra/backups/pg-backup.sh skips the upload step, keeping backups
# VM-local only, if BACKUP_S3_REMOTE is unset). Cloudflare R2, with a token
# scoped to one bucket (no https:// in the endpoint; see pg-backup.sh):
#   BACKUP_S3_REMOTE=s3,provider=Cloudflare,endpoint=<account-id>.r2.cloudflarestorage.com,env_auth=true,no_check_bucket=true
#   BACKUP_S3_BUCKET=<bucket>/prod
BACKUP_S3_REMOTE=
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
