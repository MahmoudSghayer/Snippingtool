# Staging environment for @sl/api. Copy to infra/.env.staging (next to
# infra/docker-compose.staging.yml, which reads it via `env_file`), fill in
# every value marked REQUIRED, and never commit the filled-in file (it's
# gitignored — see .gitignore's `.env.*` / `!infra/env/*.example` rule).
#
# Deployed automatically by .github/workflows/release.yml on every push to
# `main` (see docs/11-devops.md). Validate before deploying:
#   node infra/scripts/check-env.mjs infra/.env.staging

NODE_ENV=production
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# --- Data stores -------------------------------------------------------
# REQUIRED. Compose service name (`postgres`/`redis` in
# docker-compose.staging.yml) if running the bundled Postgres/Redis
# containers; a managed connection string otherwise. Always require TLS
# beyond the compose network boundary (append ?sslmode=require).
DATABASE_URL=postgres://sl:CHANGE_ME@postgres:5432/sniper_ledger
TEST_DATABASE_URL=
REDIS_URL=redis://:CHANGE_ME@redis:6379

# --- Origins / CORS ------------------------------------------------------
# REQUIRED. Staging's own subdomains — a real TLS origin, not localhost.
APP_ORIGIN=https://api.staging.sniperledger.com
DASHBOARD_ORIGIN=https://dashboard.staging.sniperledger.com
# Extension IDs allowed to call this environment's API with a bearer token.
# A staging-only build of the extension (pointed at APP_ORIGIN above via its
# own build-time config) typically has a different extension ID than the
# production Chrome Web Store listing — list both if QA loads it unpacked.
EXTENSION_IDS=

# --- Cookies / CSRF --------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 32
COOKIE_SECRET=

# --- JWT (EdDSA / Ed25519) --------------------------------------------------
# REQUIRED. Generate a fresh keypair for staging — never reuse dev's or
# prod's: `pnpm --filter @sl/api keys:generate`. Store the private halves in
# your secrets manager (docs/11-devops.md "secrets management"), not in a
# file that ever touches version control.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Entitlement blob signing (Ed25519) -------------------------------------
# REQUIRED. Same generator, a second keypair — see JWT_* above.
ENTITLEMENT_SIGNING_KEY=
ENTITLEMENT_PUBLIC_KEY=

# --- Stripe (TEST mode for staging — never live keys here) -----------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=
STRIPE_PRICE_LIFETIME=

# --- Email ---------------------------------------------------------------
# A real SMTP relay (or leave blank to no-op — verification emails will log
# a warning and not send; fine for QA that doesn't test the email flow).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM="The Sniper's Ledger (staging) <noreply@staging.sniperledger.com>"

# --- Rate limiting knobs ----------------------------------------------------
# Schema defaults (matches production) — staging should behave like
# production here so rate-limit regressions surface before a real release.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# --- Extension distribution --------------------------------------------
EXTENSION_LATEST_VERSION=0.1.0
EXTENSION_UPDATE_URL=

# --- Misc --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Seed / bootstrap (not part of the zod schema; read directly by
# packages/db/src/seed.ts — needed once, the first time `migrator` runs
# with RUN_SEED=true against a fresh staging database). ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- infra/docker-compose.staging.yml's own interpolation (${VAR} in that
# file, NOT read by @sl/api itself — listed here so one file covers
# everything `docker compose --env-file` and `env_file:` both need). ---
DOMAIN=staging.sniperledger.com
ACME_EMAIL=devops@sniperledger.com
REGISTRY=ghcr.io/sniper-ledger
IMAGE_TAG=main
API_REPLICAS=1
WORKER_REPLICAS=1
DASHBOARD_REPLICAS=1
POSTGRES_USER=sl
POSTGRES_DB=sniper_ledger
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
RUN_SEED=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PG_USER=sl_ro
GRAFANA_PG_PASSWORD=CHANGE_ME
# S3-compatible backup destination (optional — infra/backups/pg-backup.sh
# skips the upload step if BACKUP_S3_REMOTE is unset). See docs/11-devops.md.
BACKUP_S3_REMOTE=
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
