# Local development environment for @sl/api (server + worker).
#
#   cp infra/env/.env.development.example .env        # repo root, for `pnpm --filter @sl/api dev`
#   cp infra/env/.env.development.example apps/api/.env  # equivalent — apps/api's own dotenv/config
# picks up whichever .env dotenv finds first walking up from its cwd.
#
# Every value below is safe to commit and use as-is for local development —
# none of it is a real secret (dev-only JWT/entitlement keypairs are
# generated fresh below; the DB/Redis creds match infra/docker-compose.yml's
# postgres/redis services and infra/postgres/init/01-create-test-database.sql).
# Validate this file any time with:
#   node infra/scripts/check-env.mjs infra/env/.env.development.example
#
# Values here assume Postgres/Redis running on the host (127.0.0.1) — the
# "no-compose" dev path in docs/11-devops.md. Using `docker compose -f
# infra/docker-compose.yml up`, the api/worker services override
# DATABASE_URL/REDIS_URL/SMTP_* to point at the `postgres`/`redis`/`mailpit`
# service names instead (see that file's `x-api-env` anchor) — you don't
# need to edit this file for the compose path.

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
HOST=0.0.0.0

# --- Data stores -------------------------------------------------------
# Matches infra/postgres/init/*.sql (creates sniper_ledger + sniper_ledger_test,
# owned by role `sl`) and docker-compose.yml's postgres service
# (POSTGRES_USER=sl / POSTGRES_PASSWORD=sl / POSTGRES_DB=sniper_ledger).
DATABASE_URL=postgres://sl:sl@127.0.0.1:5432/sniper_ledger
TEST_DATABASE_URL=postgres://sl:sl@127.0.0.1:5432/sniper_ledger_test
REDIS_URL=redis://127.0.0.1:6379

# --- Origins / CORS ------------------------------------------------------
APP_ORIGIN=http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:5173
# Comma-separated chrome-extension:// origins (or bare extension IDs) the
# API accepts as a bearer-authenticated caller. Leave empty until you've
# loaded the unpacked extension once and copied its ID from chrome://extensions.
EXTENSION_IDS=

# --- Cookies / CSRF --------------------------------------------------------
# >=16 chars required by the zod schema; this exact value is intentionally
# public (it's this file) — never reuse it outside local dev.
COOKIE_SECRET=dev-cookie-secret-change-me-32-bytes-min

# --- JWT (EdDSA / Ed25519) --------------------------------------------------
# A real, working Ed25519 keypair generated once for this example file via
# `pnpm --filter @sl/api keys:generate` — safe to share (dev-only, not used
# anywhere but a developer's own laptop/container) and saves every new
# contributor from having to run the generator before `pnpm dev` boots.
# Regenerate your own with the same command if you'd rather not share a
# keypair with everyone else who has this repo.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIM+BIh+Ta4QdQhTQnt+Bb0yckBEDsOvUraj5Olkxd0Et\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAjtHRJeUlebKFiwgX+e5VQkc1nNVnTmg8Mk+7n1pDjPs=\n-----END PUBLIC KEY-----"

# --- Entitlement blob signing (Ed25519) -------------------------------------
# Used by /extension/bootstrap & heartbeat and the subscriptions/licensing
# flows. Same "shared dev-only keypair" reasoning as JWT_* above.
ENTITLEMENT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIME5tXz5rB088jVK2q7DxAVL2nj1BsiNAhPdUb6SgtZW\n-----END PRIVATE KEY-----"
ENTITLEMENT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA3peAlhe3c1+zIEEEclollg9MTLCmO5VY1H88EFzHNK8=\n-----END PUBLIC KEY-----"

# --- Stripe (test mode) -----------------------------------------------------
# Get test-mode values from https://dashboard.stripe.com/test/apikeys and
# https://dashboard.stripe.com/test/products — or leave blank; the
# subscriptions module degrades to manual/coupon-granted subscriptions only
# when unset (see docs/05-subscriptions.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=
STRIPE_PRICE_LIFETIME=

# --- Email ---------------------------------------------------------------
# Mailpit (infra/docker-compose.yml) captures everything sent here — view
# it at http://localhost:8025. No auth needed for a local dev SMTP relay.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="The Sniper's Ledger (dev) <noreply@sniperledger.local>"

# --- Rate limiting knobs ----------------------------------------------------
# Loosened for local dev/testing so you don't get locked out while
# iterating; staging/production use the schema defaults (see
# infra/env/.env.staging.example / .env.production.example).
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# --- Extension distribution --------------------------------------------
EXTENSION_LATEST_VERSION=0.1.0
EXTENSION_UPDATE_URL=

# --- Misc --------------------------------------------------------------
# Point at infra/docker-compose.yml's otel-collector (`monitoring` profile)
# if you want traces/metrics locally; leave blank to disable OTel export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Seed data (packages/db/src/seed.ts reads these two directly — not
# part of the zod schema above, so check-env.mjs won't validate them, but
# `pnpm --filter @sl/db seed` needs both set to create a super admin). ---
SEED_ADMIN_EMAIL=admin@sniperledger.local
SEED_ADMIN_PASSWORD=dev-only-change-me
