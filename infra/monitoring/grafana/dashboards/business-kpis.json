{
  "uid": "sl-business-kpis",
  "title": "Business KPIs",
  "tags": ["sniper-ledger", "business", "kpi"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "metric",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT metric FROM analytics_daily ORDER BY 1",
        "refresh": 2,
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "MRR (current)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT (mrr_cents::numeric / 100.0) AS \"MRR\" FROM v_mrr",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "ARR (current)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT (arr_cents::numeric / 100.0) AS \"ARR\" FROM v_arr",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Active users today",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT active_users FROM mv_kpi_daily ORDER BY day DESC LIMIT 1",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "New users today",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT new_users FROM mv_kpi_daily ORDER BY day DESC LIMIT 1",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Revenue today",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT (revenue_cents::numeric / 100.0) FROM mv_kpi_daily ORDER BY day DESC LIMIT 1",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Net platform profit today",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT net_profit_cents FROM mv_kpi_daily ORDER BY day DESC LIMIT 1",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Daily active users / new users (90d)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT day AS time, active_users FROM mv_kpi_daily WHERE $__timeFilter(day) ORDER BY day",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        },
        {
          "refId": "B",
          "rawSql": "SELECT day AS time, new_users FROM mv_kpi_daily WHERE $__timeFilter(day) ORDER BY day",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Revenue / net profit (90d)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT day AS time, (revenue_cents::numeric/100.0) AS revenue FROM mv_kpi_daily WHERE $__timeFilter(day) ORDER BY day",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        },
        {
          "refId": "B",
          "rawSql": "SELECT day AS time, (net_profit_cents::numeric/100.0) AS net_profit FROM mv_kpi_daily WHERE $__timeFilter(day) ORDER BY day",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Snipes / successes (90d)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT day AS time, snipes FROM mv_kpi_daily WHERE $__timeFilter(day) ORDER BY day",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        },
        {
          "refId": "B",
          "rawSql": "SELECT day AS time, successes FROM mv_kpi_daily WHERE $__timeFilter(day) ORDER BY day",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "$metric (analytics_daily, all dimensions)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "postgres"
      },
      "type": "timeseries",
      "description": "Generic view over the analytics_daily KPI store (docs/02-database.md \u00a76.10) \u2014 pick any metric written by the analytics.daily job from the $metric dropdown. One series per dimension value.",
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT day AS time, value, dimension FROM analytics_daily WHERE metric = '$metric' AND $__timeFilter(day) ORDER BY day",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          }
        }
      ]
    }
  ]
}
