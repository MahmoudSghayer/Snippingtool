# dependencies
node_modules/

# build outputs
dist/
build/
.turbo/
*.zip

# test / coverage
coverage/
playwright-report/
test-results/

# env
.env
.env.*
!.env.example
# infra/env/*.example are committed templates (DevOps deliverable), not
# real secrets — every other .env* file (a real infra/.env.production,
# infra/.env.staging, or root .env for local dev) stays ignored above.
!infra/env/*.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# locally downloaded CLI tools (actionlint, hadolint)
.tools/
