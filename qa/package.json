{
  "name": "@sl/qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-grade QA/security/performance/UX audit harness for Nova Trade. Browser-automated via Playwright against QA_TARGET=prod|local. See REPORT.md for findings.",
  "scripts": {
    "audit": "playwright test -c playwright.config.ts",
    "audit:headed": "playwright test -c playwright.config.ts --headed",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@sl/shared": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "otplib": "^12.0.1",
    "postgres": "^3.4.5",
    "typescript": "^5.7.3",
    "ws": "^8.18.0"
  }
}
