# Copy to .env for local development.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# --- Data stores -------------------------------------------------------
DATABASE_URL=postgres://sl:sl@127.0.0.1:5432/sniper_ledger
TEST_DATABASE_URL=postgres://sl:sl@127.0.0.1:5432/sniper_ledger_test
REDIS_URL=redis://127.0.0.1:6379
# Logical Redis DB (SELECT 0-15) used only under NODE_ENV=test, so a test
# run's rate-limit counters/dedupe keys/presence set never collide with dev
# data. Set this to a different index than another concurrently-running test
# suite (e.g. this repo's own tests vs. a second suite pointed at its own
# TEST_DATABASE_URL) so the two don't FLUSHDB/overwrite each other's state.
REDIS_TEST_DB=15

# --- Origins / CORS ------------------------------------------------------
APP_ORIGIN=http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:5173
# Comma-separated list of allowed chrome-extension:// origins (extension id
# only, no scheme required — either form is accepted).
EXTENSION_IDS=

# --- Cookies / CSRF --------------------------------------------------------
COOKIE_SECRET=dev-cookie-secret-change-me-32-bytes-min
# SameSite for sl_at/sl_rt/sl_csrf: lax (default) | strict | none. Leave lax
# whenever the dashboard and API share a registrable apex or a same-site
# proxy/rewrite fronts both (including the local Vite dev proxy). Set none
# ONLY for a dashboard on a foreign apex (e.g. a bare *.vercel.app URL);
# none always implies Secure, and in production also requires
# COOKIE_SECURE=true plus https:// APP_ORIGIN and DASHBOARD_ORIGIN (boot
# refuses otherwise). See docs/11-devops.md §6.
COOKIE_SAME_SITE=lax
# Secure cookies outside production (e.g. an https staging/preview deploy
# that isn't NODE_ENV=production). Production is always Secure.
COOKIE_SECURE=false

# --- JWT (EdDSA / Ed25519) — generate with `pnpm --filter @sl/api keys:generate` ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Entitlement blob signing (Ed25519) — used by /extension/bootstrap &
# heartbeat, and by the subscriptions module's licensing flows. ---
ENTITLEMENT_SIGNING_KEY=
ENTITLEMENT_PUBLIC_KEY=

# --- Stripe (owned by the subscriptions/payments agent; declared here so env
# validation never blocks their module) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=
STRIPE_PRICE_LIFETIME=

# --- Email (SMTP; dev/test use an in-memory JSON transport automatically) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="The Sniper's Ledger <noreply@sniperledger.local>"

# --- Rate limiting knobs ----------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# --- Extension distribution --------------------------------------------
EXTENSION_LATEST_VERSION=0.1.0
EXTENSION_UPDATE_URL=

# --- IP monitoring / geo enrichment (docs/09-security.md "IP monitoring") --
# noop (default, no external data), maxmind (local .mmdb file), or ipinfo
# (ipinfo.io token). Leave unset/noop unless one is actually configured.
GEOIP_PROVIDER=noop
GEOIP_MAXMIND_DB_PATH=
IPINFO_TOKEN=

# --- Misc --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
