{
  "name": "@sl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nova Trade — Fastify backend: REST API, WebSocket gateway and BullMQ workers.",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx src/scripts/generate-openapi.ts",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "analytics:backfill": "tsx src/lib/analytics/backfill.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@fastify/autoload": "^6.5.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/websocket": "^11.3.4",
    "@sl/db": "workspace:*",
    "@sl/shared": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.15",
    "close-with-grace": "^2.2.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.4.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.1",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "uuidv7": "^1.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@sl/config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
