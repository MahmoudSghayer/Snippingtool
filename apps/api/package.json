{
  "name": "@sl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Sniper's Ledger — Fastify backend: REST API, WebSocket gateway and BullMQ workers.",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx src/scripts/generate-openapi.ts",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "analytics:backfill": "tsx src/lib/analytics/backfill.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/csrf-protection": "^7.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/websocket": "^11.0.2",
    "@sl/db": "workspace:*",
    "@sl/shared": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.10",
    "close-with-grace": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nodemailer": "^10.0.10",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "stripe": "^22.6.2",
    "uuidv7": "^1.0.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@sl/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
