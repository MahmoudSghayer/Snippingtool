{
  "name": "@sl/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Sniper's Ledger — user + admin web dashboard (React 19 + Vite + TanStack Router/Query), deployed to Vercel as a static SPA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript ../api/openapi/openapi.json -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@sl/shared": "workspace:*",
    "@sl/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-router": "^1.92.7",
    "lucide-react": "^1.47.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@sl/config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query-devtools": "^5.62.11",
    "@tanstack/react-router-devtools": "^1.92.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.5.2",
    "otplib": "^12.0.1",
    "postgres": "^3.4.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
