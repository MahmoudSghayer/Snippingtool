# The Sniper's Ledger dashboard — environment variables.
# Vite only exposes variables prefixed VITE_ to client code; anything else
# here is read by tooling (vite.config.ts, Playwright globalSetup), not the
# browser bundle.

# --- API origin -------------------------------------------------------------
# Leave UNSET for local dev: the dashboard then makes relative `/api/v1/...`
# requests, which vite.config.ts's dev server proxies to DEV_API_PROXY_TARGET
# (default http://localhost:3000). Because the browser only ever talks to
# http://localhost:5173, the API's `sl_at`/`sl_rt`/`sl_csrf` cookies are set
# as same-site, first-party cookies with no SameSite=None/cross-site wrinkle
# — this is the recommended local setup and requires no API-side CORS entry
# beyond DASHBOARD_ORIGIN=http://localhost:5173 (apps/api/.env.example).
#
# Set this to the deployed API's origin (e.g. https://api.sniperledger.com)
# for a Vercel preview/production build, or to point a local dashboard at a
# non-proxied API. See docs/07-dashboard.md "Auth/CSRF across origins" for
# the two supported deployment shapes (same-site proxy vs. cross-site cookies)
# and what the API side must set either way.
# VITE_API_ORIGIN=https://api.sniperledger.com

# Only used by vite.config.ts's dev proxy (never sent to the browser).
DEV_API_PROXY_TARGET=http://localhost:3000
