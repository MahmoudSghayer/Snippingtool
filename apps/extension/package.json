{
  "name": "@sl/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nova Trade — MV3 Chrome extension. Build targets from one codebase: `ledger` (listable: M1 recorder + M2 assist), `ledger-auto` (adds M3 automation) and `userscript` (the same M1–M3 as one Tampermonkey script).",
  "scripts": {
    "dev": "node scripts/build.mjs ledger --watch",
    "build": "pnpm run build:ledger && pnpm run build:auto",
    "build:ledger": "node scripts/build.mjs ledger",
    "build:auto": "node scripts/build.mjs ledger-auto",
    "build:template": "node scripts/build.mjs ledger-auto --template",
    "build:userscript": "node scripts/build.mjs userscript",
    "build:userscript-template": "node scripts/build.mjs userscript --template",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tokens:sync": "node scripts/sync-tokens.mjs"
  },
  "dependencies": {
    "@sl/shared": "workspace:*",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sl/config": "workspace:*",
    "@types/chrome": "^0.3.5",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.0.0",
    "javascript-obfuscator": "^4.2.2",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
