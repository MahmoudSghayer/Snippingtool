# Copy to .env for local development. All @sl/db scripts (migrate, seed,
# db:reset, tests) read DATABASE_URL, falling back to the value below.

DATABASE_URL=postgres://sl:sl@127.0.0.1:5432/sniper_ledger

# Used only by test/*.test.ts and test-utils.ts; defaults to the _test sibling
# of DATABASE_URL's database name if unset.
TEST_DATABASE_URL=postgres://sl:sl@127.0.0.1:5432/sniper_ledger_test

# Consumed by seed.ts to create the super-admin account. Required outside of
# a fresh dev run (seed.ts also creates a dev@sniperledger.local user when
# NODE_ENV != production, independent of these).
SEED_ADMIN_EMAIL=admin@sniperledger.local
SEED_ADMIN_PASSWORD=change-me-before-deploying

NODE_ENV=development
