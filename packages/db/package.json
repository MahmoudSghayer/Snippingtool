{
  "name": "@sl/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema (hand-written SQL migrations + Drizzle ORM query layer), seed data and test utilities for The Sniper's Ledger.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "migrate": "tsx src/migrate.ts up",
    "migrate:status": "tsx src/migrate.ts status",
    "migrate:down": "tsx src/migrate.ts down",
    "seed": "tsx src/seed.ts",
    "db:reset": "tsx src/reset.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@sl/config": "workspace:*",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
